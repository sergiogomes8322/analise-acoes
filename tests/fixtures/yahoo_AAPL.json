{"info": {"currency": "USD", "financialCurrency": "USD", "currentPrice": 355.63, "regularMarketPrice": 355.63, "previousClose": 348.51, "shortName": "Apple Inc.", "longName": "Apple Inc.", "exchange": "NMS", "fullExchangeName": "NasdaqGS", "country": "United States", "sector": "Technology", "industry": "Consumer Electronics", "longBusinessSummary": "Apple Inc. designs, manufactures, and markets smartphones, personal computers, tablets, wearables, and accessories. The company offers iPhone, a line of smartphones; Mac, a line of personal computers; iPad, a line of multi-purpose tablets; and wearables, home, and accessories, including Apple Watch, AirPods, Beats products, Apple Vision Pro, Apple TV 4K, HomePod, and Apple HomeView, as well as Apple branded and third-party accessories. It also provides advertising services comprising third-party licensing arrangements and own advertising platforms; AppleCare and cloud services; and payment services, including Apple Card and Apple Pay. In addition, the company operates App Store that allow customers to discover and download applications and digital content, such as books, music, video, games, and podcasts. Further, it provides digital content through subscription-based services, including Apple Arcade, a game service; Apple Fitness+, a personalized fitness service; Apple Music, which offers users a curated listening experience; Apple News+, a news and magazine service; and Apple TV, which offers original content and live sports. The company sells its products and resells third-party products through its retail and online stores, and direct sales force; its services through its various service platforms; and third-party cellular network carriers and other resellers. It serves consumer, small and mid-sized business, education, enterprise, and government markets. The company operates in North and South America, European countries, India, the Middle East, Africa, China mainland, Hong Kong, Taiwan, Japan, Australia, New Zealand, and rest of Asia. The company was formerly known as Apple Computer, Inc. and changed its name to Apple Inc. in January 2007. Apple Inc. was founded in 1976 and is headquartered in Cupertino, California.", "sharesOutstanding": 14532182000, "beta": 1.089, "marketCap": 5168079831040}, "demonstracoes": {"income": {"index": ["EBITDA", "EBIT", "Interest Expense", "Diluted Average Shares", "Diluted EPS", "Net Income", "Tax Provision", "Pretax Income", "Gross Profit", "Total Revenue"], "columns": ["2026-09-30", "2025-09-30", "2024-09-30", "2023-09-30", "2022-09-30"], "data": [[171486000000.0, 144748000000.0, 134661000000.0, 125820000000.0, null], [158063000000.0, 133050000000.0, 123216000000.0, 114301000000.0, null], [null, null, null, 3933000000.0, 2931000000.0], [14720306000.0, 15004697000.0, 15408095000.0, 15812547000.0, null], [8.98, 7.46, 6.08, 6.13, null], [132175000000.0, 112010000000.0, 93736000000.0, 96995000000.0, null], [27062000000.0, 20719000000.0, 29749000000.0, 16741000000.0, null], [159237000000.0, 132729000000.0, 123485000000.0, 113736000000.0, null], [233602000000.0, 195201000000.0, 180683000000.0, 169148000000.0, null], [478834000000.0, 416161000000.0, 391035000000.0, 383285000000.0, null]]}, "balance": {"index": ["Total Debt", "Stockholders Equity", "Retained Earnings", "Total Liabilities Net Minority Interest", "Long Term Debt", "Current Liabilities", "Total Assets", "Net PPE", "Current Assets", "Cash And Cash Equivalents"], "columns": ["2026-09-30", "2025-09-30", "2024-09-30", "2023-09-30", "2022-09-30"], "data": [[80111000000.0, 98657000000.0, 106629000000.0, 111088000000.0, null], [112093000000.0, 73733000000.0, 56950000000.0, 62146000000.0, null], [13700000000.0, -14264000000.0, -19154000000.0, -214000000.0, null], [292455000000.0, 285508000000.0, 308030000000.0, 290437000000.0, null], [68208000000.0, 78328000000.0, 85750000000.0, 95281000000.0, null], [169915000000.0, 165631000000.0, 176392000000.0, 145308000000.0, null], [404548000000.0, 359241